# ── Secret Santa — VTI Zandhoven ─────────────────────────────────────
# Kopieer naar .env en vul in. Commit .env nooit.

# Poort op de NAS: http://NAS-IP:3004
APP_PORT=3004

# Versie van het GHCR-image (wordt door het app-dashboard gezet bij update/rollback)
APP_VERSION=latest

# Database (MariaDB)
DB_NAME=secret_santa
DB_USER=secretsanta
DB_PASSWORD=vervang-door-een-wachtwoord
DB_ROOT_PASSWORD=vervang-door-een-root-wachtwoord

# Willekeurige string voor JWT (bv. openssl rand -hex 32)
JWT_SECRET=vervang-door-een-lange-willekeurige-string

# Admin-account: wordt enkel aangemaakt als er nog geen admin bestaat.
# Laat ADMIN_PASSWORD leeg om een tijdelijk wachtwoord in de containerlog te krijgen
# (docker logs secret-santa 2>&1 | grep Admin).
ADMIN_EMAIL=nick.bogaerts@vtiz.be
ADMIN_PASSWORD=

# E-mail via Resend (domein moet geverifieerd zijn)
RESEND_API_KEY=
MAIL_FROM=VTIZ Secret Santa <status@nbotech.net>

# Publieke URL van de app, gebruikt in de persoonlijke links in de mails
APP_URL=http://10.18.0.1:3004

# Optioneel: beperk zelfinschrijving tot bepaalde e-maildomeinen (komma of spatie gescheiden).
# Leeg = geen beperking. Voorbeeld: SIGNUP_ALLOWED_DOMAINS=vtiz.be
SIGNUP_ALLOWED_DOMAINS=
